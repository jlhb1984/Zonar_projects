    "        aux_miles.append((int(unit.iloc[i,2][68:76],16))*0.000621371)\n",
    "        cont=cont+1     \n",
    "\n",
    "unit_odometer['Odometer in']=aux\n",
    "unit_odometer['Odometer en miles']=aux_miles\n",
    "\n",
